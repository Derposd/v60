<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <Company>Dota2Optimizer</Company>
    <Product>Dota 2 Optimizer</Product>
    <!-- Windows-only API is guarded at runtime; Core also compiles for tests on any OS. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep symbols inside the single-file exe so stack traces in logs stay readable. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
