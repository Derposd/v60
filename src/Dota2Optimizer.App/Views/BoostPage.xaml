<UserControl x:Class="Dota2Optimizer.App.Views.BoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Dota2Optimizer.App.Views">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource Margin.Page}">
            <TextBlock Text="WINDOWS" Style="{StaticResource Kicker}" />
            <TextBlock Text="Ускорения" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,18"
                       Text="Разовые действия. Откатывать их нечего — поэтому каждое сначала спрашивает подтверждение и честно говорит, когда оно помогает, а когда нет." />
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconBroom}" VerticalAlignment="Top" Margin="0,2,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                    <WrapPanel Margin="0,7,0,0">
                                        <Border Style="{StaticResource Tag}" Background="{Binding EffectValue, Converter={StaticResource EffectSoft}}">
                                            <TextBlock Text="{Binding Effect}" Style="{StaticResource TagText}" Foreground="{Binding EffectValue, Converter={StaticResource EffectBrush}}" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="админ" Style="{StaticResource TagText}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Honest}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource Caption}" Foreground="{StaticResource Ok}" Margin="0,6,0,0" Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                                    <v:StatusMark Width="20" Height="20" Margin="0,0,10,0" State="{Binding Mark}" Brush="{StaticResource Ok}" />
                                    <Button Content="Выполнить" Tag="{StaticResource IconPlay}" Style="{StaticResource SecondaryIcon}" Command="{Binding RunCommand}" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
