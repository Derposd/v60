<UserControl x:Class="Dota2Optimizer.App.Views.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Dota2Optimizer.App.Views">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource Margin.Page}">
            <TextBlock Text="ИГРЫ" Style="{StaticResource Kicker}" />
            <TextBlock Text="Пресеты игр" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,18"
                       Text="Готовые настройки графики через файл настроек игры — то же, что выставить в меню. Меняются только уже существующие ключи, копия файла сохраняется, выключение возвращает её. Память и файлы игры не трогаются, античит не обходится. Dota 2, CS2 и GTA RP — на своих страницах слева." />

            <Border Style="{StaticResource Inset}" Margin="0,0,0,14" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
            </Border>

            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Skeleton}" />
                <Border Style="{StaticResource Skeleton}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Games}" Visibility="{Binding IsLoading, Converter={StaticResource NotVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel Margin="2,6,4,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FoundText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Section}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Caveat}" Style="{StaticResource Caption}" Margin="2,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TweakRowTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
