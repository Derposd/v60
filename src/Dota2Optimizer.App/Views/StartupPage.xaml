<UserControl x:Class="Dota2Optimizer.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Dota2Optimizer.App.Views">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource Margin.Page}">
            <TextBlock Text="WINDOWS" Style="{StaticResource Kicker}" />
            <TextBlock Text="Автозагрузка" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,18"
                       Text="Программы, которые запускаются вместе с Windows. Выключение работает так же, как в Диспетчере задач: запись программы не удаляется, меняется только флаг «разрешено». Меньше программ в автозагрузке — быстрее вход в систему и больше свободной памяти для игры." />

            <Border Style="{StaticResource Hero}" v:Fx.Appear="True">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Обновить" Tag="{StaticResource IconRefresh}" Style="{StaticResource SecondaryIcon}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0" />
                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPower}" Width="44" Height="44" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Не выключайте драйверы звука, тачпада и антивирус — они нужны с первой секунды. Сомневаетесь — оставьте как есть." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Inset}" Margin="0,0,0,14" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
            </Border>

            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Skeleton}" Height="56" />
                <Border Style="{StaticResource Skeleton}" Height="56" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0,0,10,0" />
                                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding Source}" Style="{StaticResource TagText}" /></Border>
                                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"><TextBlock Text="админ" Style="{StaticResource TagText}" /></Border>
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}" Visibility="{Binding FileMissing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="файл не найден" Style="{StaticResource TagText}" Foreground="{StaticResource Warn}" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}" Visibility="{Binding ChangedByUs, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="изменено FrameLab" Style="{StaticResource TagText}" Foreground="{StaticResource Ok}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <v:StatusMark Width="20" Height="20" Margin="0,0,10,0" State="{Binding Mark}" Brush="{StaticResource Ok}" />
                                    <v:SwitchButton IsOn="{Binding IsOn, Mode=OneWay}" IsBusy="{Binding IsBusy}" Command="{Binding ToggleCommand}" ToolTip="Запускать вместе с Windows" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
