<Window x:Class="Dota2Optimizer.App.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что изменится" Width="760" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Перед применением" Style="{StaticResource Kicker}" />
            <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,14"
                       Text="Ниже — каждое изменение: что сейчас и что станет. Перед каждым шагом сохраняется копия; любой пункт потом отменяется кнопкой «Отменить» или «Откатить всё»." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Inset}" Padding="0">
            <ListView x:Name="Lines" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="админ" Style="{StaticResource TagText}" />
                                </Border>
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Target}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,2" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="  →  " Foreground="{DynamicResource Accent}" /><Run Text="{Binding After, Mode=OneWay}" Foreground="{StaticResource Text}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="2" x:Name="RestoreBox" Style="{StaticResource Inset}" Margin="0,12,0,0" Padding="14,10">
            <StackPanel>
                <CheckBox x:Name="RestorePointCheck" Style="{StaticResource Switch}" Content="Создать точку восстановления Windows" IsChecked="True" />
                <TextBlock x:Name="RestoreNote" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Применить" Style="{StaticResource Primary}" IsDefault="True" Click="OnApply" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Отмена" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
