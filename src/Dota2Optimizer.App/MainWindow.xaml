<Window x:Class="Dota2Optimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota 2 Optimizer" Width="1240" Height="840" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}" Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Page header: big title + one-line description. -->
        <Style TargetType="TextBlock" x:Key="PageSub" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,4,0,18" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Advice card with a severity stripe. -->
        <DataTemplate x:Key="AdviceTemplate">
            <Border Style="{StaticResource StripeCard}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityText}}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <Button Content="Открыть официальный сайт" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource Ghost}"
                            Visibility="{Binding Link, Converter={StaticResource NullToCollapsed}}"
                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Link}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <TabControl Style="{StaticResource SideNav}" SelectedIndex="{Binding SelectedTab}">

        <!-- ===================== OPTIMIZE (wizard) ===================== -->
        <TabItem Header="Оптимизация" Tag="{StaticResource IconBolt}" DataContext="{Binding Wizard}">
            <Grid Margin="32,26,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Оптимизация" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Text="Сканирование → диагноз → план → применение. Ничего не меняется без вашего подтверждения, всё можно отменить." />
                </StackPanel>

                <!-- Stepper -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding GoToStepCommand}" CommandParameter="0" Style="{StaticResource Flat}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=0}">
                                <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=0}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Сканирование" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Rectangle Grid.Column="1" Height="2" Margin="14,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=0}" />
                    <Button Grid.Column="2" Command="{Binding GoToStepCommand}" CommandParameter="1" Style="{StaticResource Flat}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=1}">
                                <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=1}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Диагноз" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Rectangle Grid.Column="3" Height="2" Margin="14,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=1}" />
                    <Button Grid.Column="4" Command="{Binding GoToStepCommand}" CommandParameter="2" Style="{StaticResource Flat}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=2}">
                                <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="План" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Rectangle Grid.Column="5" Height="2" Margin="14,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=2}" />
                    <Button Grid.Column="6" Command="{Binding GoToStepCommand}" CommandParameter="3" Style="{StaticResource Flat}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=3}">
                                <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=3}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Применение" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <!-- Step 1: scan & passport -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=0}">
                        <StackPanel>
                            <Border CornerRadius="12" Padding="22,18" Margin="0,0,0,14" Background="{StaticResource HeroGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Сканировать ПК" Style="{StaticResource Primary}" Command="{Binding ScanCommand}" VerticalAlignment="Center" Margin="0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProfileShort}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GpuShort}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text="Сканирование только читает данные: видеокарта и драйвер, процессор, память, диск, монитор, питание, Steam и Dota 2." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <WrapPanel Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <Border Style="{StaticResource StatTile}" Width="190">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Crit}" />
                                        <TextBlock Text="важных проблем" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Width="190">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WarningCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Warn}" />
                                        <TextBlock Text="предупреждений" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Width="190">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImproveCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Info}" />
                                        <TextBlock Text="можно улучшить" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Width="190">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OptimalCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Ok}" />
                                        <TextBlock Text="уже настроено" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Паспорт ПК" Style="{StaticResource H2}" Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource Card}" Padding="18,6" Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Passport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 2: diagnosis -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=1}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                                       Text="Сверху — самое важное. На этом шаге ничего не меняется и не закрывается: фоновые программы закрывайте сами, если нужно." />
                            <ItemsControl ItemsSource="{Binding Diagnosis}" ItemTemplate="{StaticResource AdviceTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 3: plan -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=2}">
                        <StackPanel>
                            <TextBlock Text="Графический пресет Dota 2" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Максимум FPS" IsChecked="{Binding IsMaxFps}" GroupName="preset" />
                                        <RadioButton Content="Баланс" IsChecked="{Binding IsBalance}" GroupName="preset" />
                                        <RadioButton Content="Качество" IsChecked="{Binding IsQuality}" GroupName="preset" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{Binding PresetHint}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Параметры запуска" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding LaunchOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,5">
                                                    <WrapPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding Effect}" FontSize="11" /></Border>
                                                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding RecommendationLabel}" FontSize="11" /></Border>
                                                        <Border Style="{StaticResource Tag}" Background="{StaticResource Warn}" Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="спорно" FontSize="11" Foreground="#111" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="22,3,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Значение +fps_max:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding FpsMaxText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="70" />
                                        <CheckBox Content="Монитор с G-Sync/FreeSync (на 3 кадра ниже частоты)" IsChecked="{Binding VariableRefresh}" Margin="16,0,0,0" />
                                    </StackPanel>
                                    <CheckBox Content="Убрать устаревшие/бесполезные параметры (-threads, -prewarm и т. п.)" IsChecked="{Binding RemoveMyths}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding MythsText}" Foreground="{StaticResource Warn}" Margin="0,6,0,0" Visibility="{Binding MythsText, Converter={StaticResource NullToCollapsed}}" />
                                    <Border Background="{StaticResource PanelAlt}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DirectX 11 или Vulkan?" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ApiText}" Margin="0,4,0,0" />
                                            <Expander Header="Как сравнить оба варианта" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding HowToCompare}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,14,0,8">
                                <Button DockPanel.Dock="Right" Content="Выбрать рекомендуемые" Style="{StaticResource Ghost}" Command="{Binding SelectRecommendedCommand}" Margin="0" />
                                <TextBlock Text="Твики" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Цвет полосы слева — эффект: зелёный — высокий, синий — средний, жёлтый — зависит от железа, серый — низкий." />
                            <ItemsControl ItemsSource="{Binding Tweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StripeCard}" BorderBrush="{Binding EffectValue, Converter={StaticResource EffectBrush}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Background="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#111" />
                                                    </Border>
                                                    <WrapPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Content="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" />
                                                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding Effect}" FontSize="11" /></Border>
                                                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding RecommendationLabel}" FontSize="11" /></Border>
                                                        <Border Style="{StaticResource Tag}" Background="{StaticResource Warn}" Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="спорно" FontSize="11" Foreground="#111" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="права администратора" FontSize="11" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="перезагрузка" FontSize="11" />
                                                        </Border>
                                                    </WrapPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding StatusText}" Margin="22,8,0,0" />
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="22,4,0,0" />
                                                <TextBlock Text="{Binding Risk}" Style="{StaticResource Caption}" Margin="22,4,0,0" FontStyle="Italic" />
                                                <TextBlock Text="{Binding ManualSteps}" Style="{StaticResource MutedText}" Margin="22,4,0,0" Visibility="{Binding ManualSteps, Converter={StaticResource NullToCollapsed}}" />
                                                <StackPanel Orientation="Horizontal" Margin="22,8,0,0" Visibility="{Binding CopyText, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBox Text="{Binding CopyText, Mode=OneWay}" IsReadOnly="True" MinWidth="340" />
                                                    <Button Content="Копировать" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding CopyText}" />
                                                </StackPanel>
                                                <Border Margin="22,10,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource PanelAlt}"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Отменить это изменение" Style="{StaticResource Undo}" Margin="8,0,0,0"
                                                                Command="{Binding DataContext.UndoTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding AppliedText}" Foreground="{StaticResource Ok}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Драйвер видеокарты" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Card}" DataContext="{Binding Vendor}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Открыть панель драйвера" Margin="0"
                                                Command="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding HowToOpen}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8"
                                               Text="Профили драйвера программа сама не меняет: у NVIDIA/AMD нет документированного и обратимого способа сделать это безопасно." />
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelAlt}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Setting, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="  →  " Foreground="{StaticResource Subtle}" />
                                                            <Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource Ok}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Why}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 4: apply -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=3}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Применить выбранное" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <CheckBox Content="Только показать, что будет изменено (dry-run)" IsChecked="{Binding DryRun}" FontWeight="SemiBold" />
                                        <CheckBox Content="Создать точку восстановления Windows перед изменениями (нужны права администратора)" IsChecked="{Binding CreateRestorePoint}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                   Text="Перед каждым шагом сохраняется копия файла или значения реестра. Любой пункт можно отменить кнопкой «Отменить» рядом с ним — в отчёте ниже, в плане или на вкладке «Откат». Dota 2 и Steam лучше закрыть." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Отчёт" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Report}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Отменить" Style="{StaticResource Undo}" Margin="8,0,0,0"
                                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.UndoReportLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Что будет / было изменено" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Preview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StripeCard}" BorderBrush="{StaticResource Info}" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,2,0,0" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                                    <Run Text="Было: " /><Run Text="{Binding Before, Mode=OneWay}" />
                                                    <Run Text="   →   Станет: " /><Run Text="{Binding After, Mode=OneWay}" Foreground="{StaticResource Ok}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="← Назад" Style="{StaticResource Ghost}" Command="{Binding BackCommand}" />
                            <Button Content="Пересканировать" Style="{StaticResource Ghost}" Command="{Binding ScanCommand}" />
                            <Button Content="Далее →" Style="{StaticResource Primary}" Command="{Binding NextCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ===================== KNOWN ISSUES ===================== -->
        <TabItem Header="Проблемы Dota 2" Tag="{StaticResource IconAlert}" DataContext="{Binding Issues}">
            <ScrollViewer Padding="32,26,32,20">
                <StackPanel>
                    <TextBlock Text="Проблемы Dota 2" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Text="Симптом → причина → что делать. Кнопки с пометкой «отменяемо» сохраняют копию и отменяются прямо здесь." />

                    <Border Style="{StaticResource StripeCard}" BorderBrush="{StaticResource Ok}" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Status}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding AppliedFixes.Count, Converter={StaticResource CountToVisible}}">
                        <StackPanel>
                            <TextBlock Text="Применённые исправления" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding AppliedFixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Отменить" Style="{StaticResource Undo}"
                                                    Command="{Binding DataContext.UndoFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource Ok}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StripeCard}" BorderBrush="{StaticResource Accent}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Symptom}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Cause}" Style="{StaticResource MutedText}" Margin="0,6,0,8" />
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,10,0,0" Visibility="{Binding HasFixes, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding DataContext.RunFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" />
                                                            <TextBlock Text="  · отменяемо" Foreground="{StaticResource Ok}" FontSize="11" VerticalAlignment="Center"
                                                                       Visibility="{Binding Reversible, Converter={StaticResource BoolToVis}}" />
