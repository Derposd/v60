                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <WrapPanel>
                        <Border Style="{StaticResource StatTile}" Width="150"><StackPanel><TextBlock Text="{Binding Elapsed}" Style="{StaticResource StatNumber}" /><TextBlock Text="время записи" Style="{StaticResource Caption}" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}" Width="250"><StackPanel><TextBlock Text="{Binding Cpu}" Style="{StaticResource StatNumber}" FontSize="18" /><TextBlock Text="процессор (частота / загрузка)" Style="{StaticResource Caption}" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}" Width="130"><StackPanel><TextBlock Text="{Binding Gpu}" Style="{StaticResource StatNumber}" /><TextBlock Text="видеокарта (3D)" Style="{StaticResource Caption}" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}" Width="150"><StackPanel><TextBlock Text="{Binding Ram}" Style="{StaticResource StatNumber}" FontSize="20" /><TextBlock Text="память игры" Style="{StaticResource Caption}" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}" Width="150"><StackPanel><TextBlock Text="{Binding Vram}" Style="{StaticResource StatNumber}" FontSize="20" /><TextBlock Text="видеопамять игры" Style="{StaticResource Caption}" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}" Width="150"><StackPanel><TextBlock Text="{Binding FreeRam}" Style="{StaticResource StatNumber}" FontSize="20" /><TextBlock Text="свободно ОЗУ" Style="{StaticResource Caption}" /></StackPanel></Border>
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
