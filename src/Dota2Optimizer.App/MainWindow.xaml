                                    <TextBlock Text="Журнал программы" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="Данные (логи, бэкапы, история): " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" Style="{StaticResource Code}" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Padding="20,10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
