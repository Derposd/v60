                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Divider}" Padding="20,12,12,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Папка логов" Tag="{StaticResource IconFolder}" Style="{StaticResource GhostIcon}" Command="{Binding OpenLogsCommand}" />
                                    <Button Content="Обновить" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostIcon}" Command="{Binding RefreshLogCommand}" Margin="0" />
                                </StackPanel>
                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconLog}" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Журнал программы" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="Данные (логи, бэкапы, история): " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" Style="{StaticResource Code}" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Padding="20,10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>

        <!-- Caption buttons over the top-right corner; the rest of the top strip drags the window. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Tag="M 0,0.5 L 10,0.5" Click="OnMinimize" ToolTip="Свернуть" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Tag="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Click="OnMaximize" ToolTip="Развернуть" />
            <Button Style="{StaticResource CloseCaptionButton}" Tag="M 0,0 L 10,10 M 10,0 L 0,10" Click="OnClose" ToolTip="Закрыть" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
