<Window x:Class="Dota2Optimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Dota2Optimizer.App.Views"
        Title="FrameLab" Width="1320" Height="880" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}" Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Advice / finding card: coloured icon, title with a severity pill, details. -->
        <DataTemplate x:Key="AdviceTemplate">
            <Border Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top"
                                    Tag="{Binding Severity, Converter={StaticResource SeverityIcon}}"
                                    Background="{Binding Severity, Converter={StaticResource SeveritySoft}}"
                                    Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,10,2" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Tag}" Background="{Binding Severity, Converter={StaticResource SeveritySoft}}">
                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityText}}" Style="{StaticResource TagText}" FontSize="10.5"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <Button Content="Открыть официальный сайт" Tag="{StaticResource IconExternal}" Style="{StaticResource GhostIcon}"
                                HorizontalAlignment="Left" Margin="-14,6,0,-4"
                                Visibility="{Binding Link, Converter={StaticResource NullToCollapsed}}"
                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Link}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tweak card with selection, effect / recommendation tags and an inline undo. The ItemsControl's DataContext
             provides CopyCommand and UndoTweakCommand. -->
        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="12,0,0,0" VerticalAlignment="Top" Padding="10,3"
                                Background="{Binding Status, Converter={StaticResource StatusSoft}}">
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TagText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        </Border>
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Content="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" />
                    </DockPanel>
                    <WrapPanel Margin="28,8,0,0">
                        <Border Style="{StaticResource Tag}" Background="{Binding EffectValue, Converter={StaticResource EffectSoft}}">
                            <TextBlock Text="{Binding Effect}" Style="{StaticResource TagText}" Foreground="{Binding EffectValue, Converter={StaticResource EffectBrush}}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentSoft}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding RecommendationLabel}" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsRecommended, Converter={StaticResource NotVis}}">
                            <TextBlock Text="{Binding RecommendationLabel}" Style="{StaticResource TagText}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}" Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="спорно" Style="{StaticResource TagText}" Foreground="{StaticResource Warn}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="права администратора" Style="{StaticResource TagText}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="нужна перезагрузка" Style="{StaticResource TagText}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusText}" Margin="28,6,0,0" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="28,4,0,0" />
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource Caption}" Margin="28,6,0,0" />
                    <TextBlock Text="{Binding ManualSteps}" Style="{StaticResource MutedText}" Margin="28,6,0,0" Visibility="{Binding ManualSteps, Converter={StaticResource NullToCollapsed}}" />
                    <DockPanel Margin="28,10,0,0" Visibility="{Binding CopyText, Converter={StaticResource NullToCollapsed}}">
                        <Button DockPanel.Dock="Right" Content="Копировать" Tag="{StaticResource IconCopy}" Style="{StaticResource SecondaryIcon}" Margin="8,0,0,0"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding CopyText}" />
                        <TextBox Text="{Binding CopyText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    </DockPanel>
                    <Border Margin="28,12,0,0" Padding="12,8" CornerRadius="10" Background="{StaticResource OkSoft}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Отменить это изменение" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.UndoTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconCheck}" Foreground="{StaticResource Ok}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AppliedText}" Foreground="{StaticResource Ok}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- GTA V graphics mode card: one of them is picked and applied at a time. -->
        <DataTemplate x:Key="GtaModeTemplate">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="gtamode" Margin="0,0,12,12" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <StackPanel>
                    <DockPanel>
                        <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding Icon}" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Tagline}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Tag}" Background="{Binding EffectValue, Converter={StaticResource EffectSoft}}">
                            <TextBlock Text="{Binding Effect}" Style="{StaticResource TagText}" Foreground="{Binding EffectValue, Converter={StaticResource EffectBrush}}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentSoft}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Рекомендуем для вашего ПК" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✓ Сейчас включён" Style="{StaticResource TagText}" Foreground="{StaticResource Ok}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>

        <!-- Stepper item of the wizard. Tag = step index as a string, Content = label. -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Command" Value="{Binding GoToStepCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="#1E2029" BorderThickness="1" Background="{StaticResource Bg}">
    <Grid>
    <TabControl x:Name="Nav" Style="{StaticResource SideNav}" SelectedIndex="{Binding SelectedTab}" v:Fx.PageTransition="True">

        <!-- ===================== HOME (main menu) ===================== -->
        <TabItem Header="Главная" Tag="{StaticResource IconStar}" DataContext="{Binding Home}">
            <ScrollViewer>
                <StackPanel Margin="40,6,36,26">
                    <TextBlock Text="FrameLab" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,20" Text="Состояние ПК и оптимизация в один клик для Dota 2 и CS2. Тонкая настройка — на страницах игр, а твики Windows и пресеты других игр — в разделе «ПК»." />

                    <!-- One-click optimisation -->
                    <Border Style="{StaticResource Hero}" Padding="28,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconBolt}" Width="64" Height="64" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Оптимизация в один клик" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Применит для всех установленных игр только то, что программа рекомендует для вашего ПК: пресет графики, параметры запуска, нужные настройки Windows." />
                                <WrapPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}" Margin="0,0,8,6"><TextBlock Text="Только безопасное" Style="{StaticResource TagText}" Foreground="{StaticResource Ok}" /></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource InfoSoft}" Margin="0,0,8,6"><TextBlock Text="Без перезагрузки" Style="{StaticResource TagText}" Foreground="{StaticResource Info}" /></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource NeutralSoft}" Margin="0,0,8,6"><TextBlock Text="Программы не закрываются" Style="{StaticResource TagText}" /></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource NeutralSoft}" Margin="0,0,8,6"><TextBlock Text="Всё отменяется" Style="{StaticResource TagText}" /></Border>
                                </WrapPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Оптимизировать" Tag="{StaticResource IconBolt}" Style="{StaticResource PrimaryIcon}" Command="{Binding OptimizeCommand}"
                                    VerticalAlignment="Center" Padding="30,15" FontSize="16" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,16" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Отменить всё" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Command="{Binding UndoAllCommand}" />
                                <TextBlock Text="Отчёт" Style="{StaticResource Section}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Report}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Отменить" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.UndoLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- PC -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconCpu}" Width="40" Height="40" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProfileText}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <DockPanel><TextBlock Text="Процессор" Foreground="{StaticResource Subtle}" Width="92" /><TextBlock Text="{Binding CpuText}" TextTrimming="CharacterEllipsis" /></DockPanel>
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <DockPanel><TextBlock Text="Память" Foreground="{StaticResource Subtle}" Width="92" /><TextBlock Text="{Binding RamText}" TextTrimming="CharacterEllipsis" /></DockPanel>
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <DockPanel><TextBlock Text="Монитор" Foreground="{StaticResource Subtle}" Width="92" /><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" /></DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Games -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Игры" Style="{StaticResource Section}" Margin="0,0,0,8" />
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Открыть" Tag="{StaticResource IconChevron}" Style="{StaticResource GhostIcon}" VerticalAlignment="Center"
                                                Command="{Binding OpenPcCommand}" />
                                        <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,14,0" Background="{StaticResource PcTile}">
                                            <TextBlock Text="ПК" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#04201C" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Windows и другие игры" FontWeight="SemiBold" />
                                            <TextBlock Text="Твики системы, игровой режим, Fortnite, Valorant, Minecraft, Apex, бенчмарк" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Games}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Открыть" Tag="{StaticResource IconChevron}" Style="{StaticResource GhostIcon}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,14,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource DotaTile}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCs2}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Cs2Tile}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCs2}" Value="True">
                                                                            <Setter Property="Foreground" Value="#2A1A04" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Открыть" Tag="{StaticResource IconChevron}" Style="{StaticResource GhostIcon}" VerticalAlignment="Center"
                                                Command="{Binding OpenGtaCommand}" />
                                        <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,14,0" Background="{StaticResource GtaTile}">
                                            <TextBlock Text="RP" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="White" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="GTA V · RP" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding GtaState}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Session boost -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPlay}" Width="38" Height="38" Margin="0,0,12,0" />
                                    <TextBlock Text="Ускорение на время игры" Style="{StaticResource CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Как игровой режим Game Booster: пока идёт Dota 2 или CS2, включается план питания «Высокая производительность», после игры возвращается прежний. Программы не закрываются." />
                                <CheckBox Style="{StaticResource Switch}" Content="Включено" IsChecked="{Binding BoostEnabled}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding BoostState}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Background apps -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostIcon}" ToolTip="Обновить" Command="{Binding RefreshBackgroundCommand}" Padding="8" />
                                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPulse}" Width="38" Height="38" Margin="0,0,12,0" />
                                    <TextBlock Text="Мешают игре сейчас" Style="{StaticResource CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Text="Тяжёлых фоновых программ не найдено." Style="{StaticResource MutedText}" Visibility="{Binding HasBackground, Converter={StaticResource NotVis}}" />
                                <ItemsControl ItemsSource="{Binding Background}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10" ToolTip="{Binding App.Advice}">
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding App.DisplayName, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Subtle}" /><Run Text="{Binding WorkingSetMb, Mode=OneWay}" Foreground="{StaticResource Subtle}" /><Run Text=" МБ" Foreground="{StaticResource Subtle}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding App.Advice}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Программа только подсказывает — закрывать или нет, решаете вы." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Temp files -->
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconTrash}" Width="38" Height="38" Margin="0,0,12,0" />
                                    <TextBlock Text="Временные файлы" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TempText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Файлы из папки TEMP старше суток — то же, что «Очистка диска». Используемые файлы пропускаются." />
                                <Button Content="Очистить" Tag="{StaticResource IconTrash}" Style="{StaticResource SecondaryIcon}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanTempCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding SectionTitle}" Style="{StaticResource NavSection}" />

        <!-- ===================== OPTIMIZE (wizard) ===================== -->
        <TabItem Header="Оптимизация" Tag="{StaticResource IconBolt}" DataContext="{Binding Current.Wizard}" Visibility="{Binding DataContext.IsGamePages, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <Grid Margin="40,6,36,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding GameName}" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Оптимизация" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Text="Сканирование → диагноз → план → применение. Всё подбирается под эту игру и ваш ПК; ничего не меняется без подтверждения, и всё можно отменить." />
                </StackPanel>

                <!-- Stepper -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource StepButton}" Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=0}">
                                    <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=0}" Foreground="{Binding Step, Converter={StaticResource StepText}, ConverterParameter=0}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ШАГ 1" Style="{StaticResource Overline}" FontSize="10" LineHeight="13" />
                                    <TextBlock Text="Сканирование" FontWeight="SemiBold" LineHeight="18" Foreground="{Binding Step, Converter={StaticResource StepLabel}, ConverterParameter=0}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Rectangle Grid.Column="1" Height="2" RadiusX="1" RadiusY="1" Margin="16,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=0}" />
                        <Button Grid.Column="2" Style="{StaticResource StepButton}" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=1}">
                                    <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=1}" Foreground="{Binding Step, Converter={StaticResource StepText}, ConverterParameter=1}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ШАГ 2" Style="{StaticResource Overline}" FontSize="10" LineHeight="13" />
                                    <TextBlock Text="Диагноз" FontWeight="SemiBold" LineHeight="18" Foreground="{Binding Step, Converter={StaticResource StepLabel}, ConverterParameter=1}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Rectangle Grid.Column="3" Height="2" RadiusX="1" RadiusY="1" Margin="16,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=1}" />
                        <Button Grid.Column="4" Style="{StaticResource StepButton}" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=2}">
                                    <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=2}" Foreground="{Binding Step, Converter={StaticResource StepText}, ConverterParameter=2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ШАГ 3" Style="{StaticResource Overline}" FontSize="10" LineHeight="13" />
                                    <TextBlock Text="План" FontWeight="SemiBold" LineHeight="18" Foreground="{Binding Step, Converter={StaticResource StepLabel}, ConverterParameter=2}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Rectangle Grid.Column="5" Height="2" RadiusX="1" RadiusY="1" Margin="16,0" Fill="{Binding Step, Converter={StaticResource StepLine}, ConverterParameter=2}" />
                        <Button Grid.Column="6" Style="{StaticResource StepButton}" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Step, Converter={StaticResource StepFill}, ConverterParameter=3}">
                                    <TextBlock Text="{Binding Step, Converter={StaticResource StepGlyph}, ConverterParameter=3}" Foreground="{Binding Step, Converter={StaticResource StepText}, ConverterParameter=3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ШАГ 4" Style="{StaticResource Overline}" FontSize="10" LineHeight="13" />
                                    <TextBlock Text="Применение" FontWeight="SemiBold" LineHeight="18" Foreground="{Binding Step, Converter={StaticResource StepLabel}, ConverterParameter=3}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <!-- Step 1: scan & passport -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=0}">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Hero}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconCpu}" Width="56" Height="56" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProfileShort}" Style="{StaticResource H1}" />
                                        <TextBlock Text="{Binding GpuShort}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                                   Text="Сканирование только читает данные: видеокарта и драйвер, процессор, память, диск, монитор, питание, Steam и игры." />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ScanAgeText}" TextWrapping="Wrap"
                                                   Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ScanButtonText}" Tag="{StaticResource IconSearch}" Style="{StaticResource PrimaryIcon}"
                                            Command="{Binding ScanCommand}" VerticalAlignment="Center" Margin="0" Padding="20,10" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Что проверим" Style="{StaticResource Section}" Margin="2,6,0,12" Visibility="{Binding Scanned, Converter={StaticResource NotVis}}" />
                            <UniformGrid Columns="3" Margin="0,0,-12,4" Visibility="{Binding Scanned, Converter={StaticResource NotVis}}">
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconMonitor}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Видеокарта и драйвер" FontWeight="SemiBold" />
                                            <TextBlock Text="модель, видеопамять, возраст драйвера, гибридная графика" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconCpu}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Процессор и память" FontWeight="SemiBold" />
                                            <TextBlock Text="ядра, частота, объём и режим каналов памяти" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconDisk}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Диск и место" FontWeight="SemiBold" />
                                            <TextBlock Text="SSD или HDD под игрой, свободное место для обновлений" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconBolt}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Питание и Windows" FontWeight="SemiBold" />
                                            <TextBlock Text="план питания, Game Mode, Game DVR, HAGS, оптимизации окна" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconSliders}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Настройки игры" FontWeight="SemiBold" />
                                            <TextBlock Text="графика в конфиге игры, параметры запуска, режим экрана" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="18,16">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPulse}" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Фоновые программы" FontWeight="SemiBold" />
                                            <TextBlock Text="что съедает FPS: запись, оверлеи, загрузки, RGB-софт" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,0,-12,4" Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource StatTile}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBadge}" Tag="{StaticResource IconAlertCircle}" Width="32" Height="32"
                                                        Background="{StaticResource CritSoft}" Foreground="{StaticResource Crit}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatNumber}" />
                                            <TextBlock Text="важных проблем" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBadge}" Tag="{StaticResource IconAlert}" Width="32" Height="32"
                                                        Background="{StaticResource WarnSoft}" Foreground="{StaticResource Warn}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding WarningCount}" Style="{StaticResource StatNumber}" />
                                            <TextBlock Text="предупреждений" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBadge}" Tag="{StaticResource IconBolt}" Width="32" Height="32"
                                                        Background="{StaticResource InfoSoft}" Foreground="{StaticResource Info}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding ImproveCount}" Style="{StaticResource StatNumber}" />
                                            <TextBlock Text="можно улучшить" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBadge}" Tag="{StaticResource IconCheck}" Width="32" Height="32"
                                                        Background="{StaticResource OkSoft}" Foreground="{StaticResource Ok}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding OptimalCount}" Style="{StaticResource StatNumber}" />
                                            <TextBlock Text="уже настроено" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="20,16,20,8">
                                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconMonitor}" Margin="0,0,10,0" />
                                        <TextBlock Text="Паспорт ПК" Style="{StaticResource Section}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Passport}" Margin="20,0,20,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 2: diagnosis -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=1}">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,14">
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconInfo}" Foreground="{StaticResource Info}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Text="Сверху — самое важное. На этом шаге ничего не меняется и не закрывается: фоновые программы закрывайте сами, если нужно." />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Diagnosis}" ItemTemplate="{StaticResource AdviceTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 3: plan -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=2}">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconSliders}" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName, StringFormat=Графический пресет {0}}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding Target.VideoFileName, StringFormat=Настройки графики в {0}. Игру лучше закрыть.}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource SegmentHost}" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Максимум FPS" IsChecked="{Binding IsMaxFps}" GroupName="preset" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Баланс" IsChecked="{Binding IsBalance}" GroupName="preset" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Качество" IsChecked="{Binding IsQuality}" GroupName="preset" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" Text="{Binding PresetHint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPlay}" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Параметры запуска" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Строка в свойствах игры в Steam. Отмечайте только то, что нужно; ваши собственные параметры сохраняются." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding LaunchOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,10">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" FontWeight="SemiBold" Margin="0,0,12,4" />
                                                            <Border Style="{StaticResource Tag}" Background="{Binding EffectValue, Converter={StaticResource EffectSoft}}">
                                                                <TextBlock Text="{Binding Effect}" Style="{StaticResource TagText}" Foreground="{Binding EffectValue, Converter={StaticResource EffectBrush}}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentSoft}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding RecommendationLabel}" Style="{StaticResource TagText}" Foreground="{DynamicResource Accent}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsRecommended, Converter={StaticResource NotVis}}">
                                                                <TextBlock Text="{Binding RecommendationLabel}" Style="{StaticResource TagText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}" Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="спорно" Style="{StaticResource TagText}" Foreground="{StaticResource Warn}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="28,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource Inset}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="+fps_max" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Text="{Binding FpsMaxText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="80" HorizontalAlignment="Left" />
                                            </DockPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="Монитор с G-Sync / FreeSync (ограничить на 3 кадра ниже частоты)" IsChecked="{Binding VariableRefresh}" Margin="0,12,0,0" />
                                            <CheckBox Style="{StaticResource Switch}" Content="{Binding MythsLabel}" IsChecked="{Binding RemoveMyths}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding MythsText}" Foreground="{StaticResource Warn}" Margin="50,4,0,0" Visibility="{Binding MythsText, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Inset}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DirectX 11 или Vulkan?" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ApiText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            <Expander Header="Как сравнить оба варианта" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding HowToCompare}" Style="{StaticResource MutedText}" Margin="18,6,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,10,0,12">
                                <Button DockPanel.Dock="Right" Content="Выбрать рекомендуемые" Tag="{StaticResource IconStar}" Style="{StaticResource GhostIcon}" Command="{Binding SelectRecommendedCommand}" Margin="0" />
                                <StackPanel>
                                    <TextBlock Text="Все пункты плана" Style="{StaticResource Section}" />
                                    <TextBlock Text="Цвет метки «Эффект»: зелёный — высокий, синий — средний, жёлтый — зависит от железа, серый — низкий." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource TweakTemplate}" />

                            <Border Style="{StaticResource Card}" DataContext="{Binding Vendor}" Margin="0,10,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Открыть панель драйвера" Tag="{StaticResource IconExternal}" Style="{StaticResource SecondaryIcon}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconMonitor}" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding HowToOpen}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,10"
                                               Text="Профили драйвера программа сама не меняет: у NVIDIA и AMD нет документированного и обратимого способа сделать это безопасно." />
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Inset}" Padding="14,10" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Setting, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="  →  " Foreground="{StaticResource Subtle}" />
                                                            <Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource Ok}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Why}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource Subtle}" Margin="4,8,10,0" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 4: apply -->
                    <ScrollViewer Visibility="{Binding Step, Converter={StaticResource EqualsToVisible}, ConverterParameter=3}">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Hero}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource Switch}" Content="Только показать, что будет изменено (dry-run)" IsChecked="{Binding DryRun}" FontWeight="SemiBold" />
                                        <CheckBox Style="{StaticResource Switch}" Content="Создать точку восстановления Windows перед изменениями (нужны права администратора)" IsChecked="{Binding CreateRestorePoint}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="50,8,0,0"
                                                   Text="Перед каждым шагом сохраняется копия файла или значения реестра. Любой пункт можно отменить кнопкой «Отменить» — в отчёте ниже, в плане или на вкладке «Откат». Игру и Steam лучше закрыть." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Применить выбранное" Tag="{StaticResource IconBolt}" Style="{StaticResource PrimaryIcon}" Command="{Binding ApplyCommand}"
                                            VerticalAlignment="Center" Margin="20,0,0,0" Padding="20,10" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Visibility="{Binding Report.Count, Converter={StaticResource CountToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="Отчёт" Style="{StaticResource Section}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Report}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Отменить" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.UndoReportLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Что будет / было изменено" Style="{StaticResource Section}" Margin="0,8,0,10" Visibility="{Binding Preview.Count, Converter={StaticResource CountToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Preview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Inset}" Padding="10,6">
                                                        <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="Было: " Foreground="{StaticResource Subtle}" /><Run Text="{Binding Before, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                    <ContentControl Grid.Column="1" Style="{StaticResource Icon}" Tag="{StaticResource IconChevron}" Margin="10,0" Foreground="{StaticResource Subtle}" />
                                                    <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="10,6" Background="{StaticResource OkSoft}">
                                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ok}">
                                                            <Run Text="Станет: " /><Run Text="{Binding After, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Назад" Style="{StaticResource Ghost}" Command="{Binding BackCommand}" />
                            <Button Content="Пересканировать" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostIcon}" Command="{Binding ScanCommand}" />
                            <Button Content="Далее" Style="{StaticResource Primary}" Command="{Binding NextCommand}" Margin="0" Padding="26,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ===================== KNOWN ISSUES ===================== -->
        <TabItem Header="Проблемы" Tag="{StaticResource IconAlert}" DataContext="{Binding Current.Issues}" Visibility="{Binding DataContext.IsGamePages, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <StackPanel Margin="40,6,30,28">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding GameName}" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Проблемы и решения" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSub}" Text="Выберите симптом — внутри причина, пошаговое решение и исправления в один клик." />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Поиск по симптомам" Width="280" VerticalAlignment="Bottom" Margin="20,0,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Border Style="{StaticResource Card}" Background="{StaticResource OkSoft}" BorderBrush="{StaticResource OkSoftBorder}" Padding="16,12"
                            Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconInfo}" Foreground="{StaticResource Ok}" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Status}" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding AppliedFixes.Count, Converter={StaticResource CountToVisible}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconShieldCheck}" Foreground="{StaticResource Ok}" Margin="0,0,10,0" />
                                <TextBlock Text="Применённые исправления" Style="{StaticResource Section}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding AppliedFixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Отменить" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Margin="0"
                                                        Command="{Binding DataContext.UndoFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource AccordionCard}">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBadge}" Width="40" Height="40" Tag="{Binding Icon}" Background="{Binding ToneSoft}" Foreground="{Binding ToneBrush}" />
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Symptom}" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="{Binding Cause}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Tag}" Margin="0">
                                                <TextBlock Text="{Binding FixCountText}" Style="{StaticResource TagText}" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="ПОЧЕМУ ТАК" Style="{StaticResource Overline}" />
                                        <TextBlock Text="{Binding Cause}" Style="{StaticResource MutedText}" Margin="0,6,0,16" />

                                        <TextBlock Text="ЧТО ДЕЛАТЬ" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="12,2,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource Inset}" Margin="0,8,0,0" Visibility="{Binding HasFixes, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="ИСПРАВИТЬ В ОДИН КЛИК" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                                                <ItemsControl ItemsSource="{Binding Fixes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Margin="0,0,8,6" Padding="12,7"
                                                                    Command="{Binding DataContext.RunFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconWrench}" Width="14" Height="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                                    <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}" Margin="10,0,0,0" Padding="6,0"
                                                                            Visibility="{Binding Reversible, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="отменяемо" Style="{StaticResource TagText}" FontSize="10.5" Foreground="{StaticResource Ok}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <DockPanel Margin="0,12,0,0">
                                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconInfo}" Width="13" Height="13" Foreground="{StaticResource Subtle}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Inset}" Padding="18,16" Visibility="{Binding NothingFound, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ничего не найдено. Попробуйте другое слово: «фризы», «вылет», «пинг», «экран»." Style="{StaticResource MutedText}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Посчитать" Tag="{StaticResource IconSearch}" Style="{StaticResource SecondaryIcon}" Command="{Binding DiskUsageCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconDisk}" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Что игра накопила на диске" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Повторы, файлы Мастерской и прочее, что можно удалить вручную." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding DiskUsage}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Открыть папку" Tag="{StaticResource IconFolder}" Style="{StaticResource GhostIcon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}" />
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SizeBytes, Converter={StaticResource SizeText}}" Style="{StaticResource TagText}" Foreground="{StaticResource Warn}" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== MATCH MONITOR ===================== -->
        <TabItem Header="Монитор матча" Tag="{StaticResource IconPulse}" DataContext="{Binding Current.Monitor}" Visibility="{Binding DataContext.IsGamePages, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <StackPanel Margin="40,6,30,28">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding GameName}" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Монитор матча" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSub}" Text="Почему падает FPS к концу игры? Запишите матч целиком — в конце будет ответ и конкретный фикс." />
                    </StackPanel>

                    <Border Style="{StaticResource Hero}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPulse}" Width="56" Height="56" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="Начать запись" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryIcon}" Command="{Binding StartCommand}" Margin="0,0,0,8" Padding="20,10" />
                                <Button Content="Стоп и анализ" Tag="{StaticResource IconStop}" Style="{StaticResource SecondaryIcon}" Command="{Binding StopCommand}" Margin="0" Padding="20,9" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,-12,4">
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconClock}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Время записи" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Elapsed}" Style="{StaticResource StatNumber}" FontSize="24" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconCpu}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Процессор · частота / загрузка" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Cpu}" Style="{StaticResource StatNumber}" FontSize="20" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconMonitor}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Видеокарта · 3D" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Gpu}" Style="{StaticResource StatNumber}" FontSize="24" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconDisk}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Память игры" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Ram}" Style="{StaticResource StatNumber}" FontSize="24" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconMonitor}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Видеопамять игры" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Vram}" Style="{StaticResource StatNumber}" FontSize="24" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconDisk}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Subtle}" />
                                    <TextBlock Text="Свободно ОЗУ" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding FreeRam}" Style="{StaticResource StatNumber}" FontSize="24" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="ИТОГ МАТЧА" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" LineHeight="23" Margin="0,6,0,0" />
                            <Border Style="{StaticResource Inset}" Margin="0,14,0,0" Padding="16,14" Visibility="{Binding Bars.Count, Converter={StaticResource CountToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="FPS по минутам" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Bars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,4,0" Width="16" ToolTip="{Binding Tooltip}" VerticalAlignment="Bottom">
                                                        <Border Height="{Binding Height}" CornerRadius="4,4,1,1" Background="{DynamicResource BarGradient}" VerticalAlignment="Bottom" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="9.5" HorizontalAlignment="Center" TextWrapping="NoWrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource AdviceTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== CRASHES ===================== -->
        <TabItem Header="Вылеты и сбои" Tag="{StaticResource IconShield}" DataContext="{Binding Current.Crash}" Visibility="{Binding DataContext.IsGamePages, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <StackPanel Margin="40,6,30,28">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding GameName}" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Вылеты и сбои" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSub}" Text="Журнал Windows за 30 дней, дампы и логи игры — понятная причина и что делать. Только чтение." />
                    </StackPanel>

                    <Border Style="{StaticResource Hero}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconShield}" Width="56" Height="56" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="14" />
                            </Grid>
                            <WrapPanel Margin="74,16,0,0">
                                <Button Content="Анализировать" Tag="{StaticResource IconSearch}" Style="{StaticResource PrimaryIcon}" Command="{Binding AnalyzeCommand}" Margin="0,0,8,6" />
                                <Button Content="Проверить файлы игры" Tag="{StaticResource IconShieldCheck}" Style="{StaticResource SecondaryIcon}" Command="{Binding ValidateCommand}" Margin="0,0,8,6" />
                                <Button Content="Очистить кеш загрузки Steam" Tag="{StaticResource IconRefresh}" Style="{StaticResource SecondaryIcon}" Command="{Binding FlushDownloadCacheCommand}" Margin="0,0,8,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Причины сбоев" Style="{StaticResource Section}" Margin="0,10,0,10" Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top"
                                                        Tag="{Binding Severity, Converter={StaticResource SeverityIcon}}"
                                                        Background="{Binding Severity, Converter={StaticResource SeveritySoft}}"
                                                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,10,2" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding Category}" Style="{StaticResource TagText}" /></Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                <Run Text="Раз: " /><Run Text="{Binding Count, Mode=OneWay}" />
                                                <Run Text=" · последний: " /><Run Text="{Binding LastSeen, Mode=OneWay, StringFormat=dd.MM.yyyy HH:mm}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Advice}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Логи игры и Steam" Style="{StaticResource Section}" Margin="0,10,0,10" Visibility="{Binding LogFindings.Count, Converter={StaticResource CountToVisible}}" />
                    <ItemsControl ItemsSource="{Binding LogFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top" Tag="{StaticResource IconLog}"
                                                        Background="{Binding Severity, Converter={StaticResource SeveritySoft}}"
                                                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding Advice}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            <Border Style="{StaticResource Inset}" Padding="10,6" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Sample}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconCpu}" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Компоненты" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Библиотеки, без которых игра может не запускаться или вылетать." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Runtimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Скачать (Microsoft)" Tag="{StaticResource IconExternal}" Style="{StaticResource GhostIcon}" Margin="8,0,0,0"
                                                        Visibility="{Binding Link, Converter={StaticResource NullToCollapsed}}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Link}" />
                                                <Ellipse Width="8" Height="8" Fill="{Binding Ok, Converter={StaticResource BoolBrush}}" Margin="2,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="240" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconFolder}" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Дампы сбоев" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Не разбираются автоматически: по ним видно время сбоя, их можно приложить к обращению в поддержку." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Dumps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Папка" Tag="{StaticResource IconFolder}" Style="{StaticResource GhostIcon}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.OpenDumpFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}" />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=dd.MM.yyyy HH:mm}" FontWeight="SemiBold" />
                                                    <Run Text="  " /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                                    <Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" Foreground="{StaticResource Subtle}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Найти кеши" Tag="{StaticResource IconSearch}" Style="{StaticResource GhostIcon}" Command="{Binding ScanCachesCommand}" />
                                    <Button Content="Очистить выбранные" Tag="{StaticResource IconTrash}" Style="{StaticResource SecondaryIcon}" Command="{Binding CleanCachesCommand}" Margin="0" />
                                </StackPanel>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconBolt}" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Кеш шейдеров" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Пересоздаётся сам. После очистки первые 1–2 матча могут подтормаживать." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Caches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,0">
                                                    <Run Text="{Binding Note, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Известные конфликты" Style="{StaticResource Section}" Margin="0,10,0,10" />
                    <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Advice}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Inset}" Background="{StaticResource WarnSoft}" Margin="0,4,0,0">
                        <DockPanel>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconAlert}" Foreground="{StaticResource Warn}" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Нестабильный разгон или андервольт CPU, GPU и памяти (включая XMP/EXPO) — одна из самых частых причин вылетов. Программа его не трогает: проверьте игру с настройками по умолчанию сами." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== GTA RP: GRAPHICS MODES ===================== -->
        <TabItem Header="Режимы графики" Tag="{StaticResource IconSliders}" DataContext="{Binding Gta}"
                 Visibility="{Binding DataContext.IsGta, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <StackPanel Margin="40,6,36,26">
                    <TextBlock Text="GTA V · RP-проекты" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Режимы графики" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,8"
                               Text="Готовые настройки GTA V: три подбираются по мощности ПК, два сделаны для РП. Меняются только значения в settings.xml («Документы»), копия файла сохраняется, и всё возвращается одной кнопкой." />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <!-- Where GTA V, its settings and RAGE MP are -->
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconPlay}" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="GTA V" Style="{StaticResource Overline}" />
                                    <TextBlock Text="{Binding GameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameText}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding EditionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconSliders}" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="ФАЙЛ НАСТРОЕК" Style="{StaticResource Overline}" />
                                    <TextBlock Text="{Binding SettingsText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <Button Content="Открыть папку" Tag="{StaticResource IconFolder}" Style="{StaticResource GhostIcon}" HorizontalAlignment="Left" Margin="-14,0,0,-6"
                                            Command="{Binding OpenSettingsFolderCommand}" ToolTip="{Binding SettingsPathText}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="4">
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconWifi}" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="RAGE MP" Style="{StaticResource Overline}" />
                                    <TextBlock Text="{Binding RageMpText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding RageMpText}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding RageMpSub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Button Grid.Column="5" Content="Проверить снова" Tag="{StaticResource IconRefresh}" Style="{StaticResource SecondaryIcon}"
                                    VerticalAlignment="Center" Margin="18,0,0,0" Command="{Binding RefreshCommand}" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12" CornerRadius="12" Background="{StaticResource WarnSoft}" Margin="0,0,0,14"
                            Visibility="{Binding GameRunning, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconAlert}" Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding RunningText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Recommendation -->
                    <Border Style="{StaticResource Hero}" Margin="0,0,0,22">
                        <DockPanel>
                            <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconStar}" Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,18,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendTitle}" Style="{StaticResource H1}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecommendReason}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <DockPanel Margin="0,10,0,0">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveMode}" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconInfo}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                    Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                                    <TextBlock Text="{Binding ActiveText}" TextWrapping="Wrap"
                                               Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="По мощности ПК" Style="{StaticResource Section}" />
                    <TextBlock Text="Больше FPS ценой картинки. Текстуры дополнительно ограничиваются объёмом видеопамяти." Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding PerformanceModes}" ItemTemplate="{StaticResource GtaModeTemplate}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="Для РП" Style="{StaticResource Section}" Margin="0,10,0,0" />
                    <TextBlock Text="Красивая картинка для отыгрыша — или золотая середина между картинкой и FPS." Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding RoleplayModes}" ItemTemplate="{StaticResource GtaModeTemplate}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Apply bar -->
                    <Border Style="{StaticResource Card}" Margin="0,6,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Вернуть как было" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Command="{Binding UndoModeCommand}" Margin="0,0,10,0"
                                        ToolTip="Восстановить settings.xml, который был до первого применения режима" />
                                <Button Content="Применить режим" Tag="{StaticResource IconBolt}" Style="{StaticResource PrimaryIcon}" Command="{Binding ApplyModeCommand}" Padding="24,12" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding SelectedStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <TextBlock Text="Применяется один режим за раз: следующий заменяет предыдущий, а «Вернуть как было» восстанавливает исходный файл." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Отчёт" Style="{StaticResource Section}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Report}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Отменить" Tag="{StaticResource IconUndo}" Style="{StaticResource UndoIcon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.UndoLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Roleplay project -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="GTA5RP" IsChecked="{Binding IsGta5Rp}" GroupName="rpproject" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Majestic RP" IsChecked="{Binding IsMajestic}" GroupName="rpproject" />
                                    </StackPanel>
                                </Border>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconInfo}" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ваш проект" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Игра и её настройки общие для всех серверов: выбор проекта меняет только подсказки." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Inset}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Project.Text}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Other GTA / Windows tweaks -->
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding HasTweaks, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="Применить выбранное" Tag="{StaticResource IconCheck}" Style="{StaticResource SecondaryIcon}" Command="{Binding ApplyTweaksCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Ещё для GTA V и Windows" Style="{StaticResource Section}" />
                            <TextBlock Text="Отмечены только рекомендуемые для вашего ПК пункты; спорные по умолчанию выключены. Всё отменяется здесь или на вкладке «Откат»." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource TweakTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== GTA RP: REDUX ===================== -->
        <TabItem Header="Редуксы" Tag="{StaticResource IconFolder}" DataContext="{Binding Gta.Redux}"
                 Visibility="{Binding DataContext.IsGta, ElementName=Nav, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <StackPanel Margin="40,6,36,26">
                    <TextBlock Text="GTA V · графические моды" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Редуксы" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,20"
                               Text="Установка графического пака в папку GTA V с резервной копией. Перед копированием пак проверяется: видно, что встанет, что заблокировано и почему. Удаление возвращает оригинальные файлы игры." />

                    <Border Padding="18,14" CornerRadius="14" Background="{StaticResource CritSoft}" Margin="0,0,0,14">
                        <DockPanel>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconShield}" Foreground="{StaticResource Crit}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Скрипты, DLL, ASI и ReShade не устанавливаются" FontWeight="SemiBold" Foreground="{StaticResource Crit}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Проверьте правила вашего проекта: паки, убирающие объекты, делающие текстуры прозрачными или дающие другое преимущество, считаются читом и ведут к бану. Приложение ставит только файлы графики — модели, текстуры, таймциклы." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Padding="18,12" CornerRadius="14" Background="{StaticResource WarnSoft}" Margin="0,0,0,14"
                            Visibility="{Binding HasUnfinished, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconAlert}" Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                       Text="Есть прерванная установка (программа или ПК выключились посреди копирования). Откатите её в списке «Установленные паки» ниже — оригиналы вернутся на место." />
                        </DockPanel>
                    </Border>

                    <!-- 1. GTA V folder -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. Папка GTA V" Style="{StaticResource CardTitle}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Выбрать…" Tag="{StaticResource IconFolder}" Style="{StaticResource SecondaryIcon}" Command="{Binding BrowseGtaCommand}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Найти" Tag="{StaticResource IconSearch}" Style="{StaticResource GhostIcon}" Command="{Binding FindGtaCommand}" Margin="8,0,0,0"
                                        ToolTip="Подставить папку, найденную автоматически" />
                                <TextBox Text="{Binding GtaDir, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding GtaDirState}" Margin="2,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GtaDirOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 2. Pack -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. Пак: папка или архив .zip / .7z / .rar" Style="{StaticResource CardTitle}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Архив…" Tag="{StaticResource IconFolder}" Style="{StaticResource SecondaryIcon}" Command="{Binding BrowsePackArchiveCommand}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Папка…" Tag="{StaticResource IconFolder}" Style="{StaticResource SecondaryIcon}" Command="{Binding BrowsePackFolderCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding PackPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Проверить" Tag="{StaticResource IconSearch}" Style="{StaticResource PrimaryIcon}" Command="{Binding CheckCommand}" Padding="22,11" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,16,0"
                                           Text="Для .7z и .rar нужен бесплатный 7-Zip, иначе используется встроенный в Windows tar. Проверка ничего не копирует в игру." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="2,2,0,12" />

                    <Border Style="{StaticResource Card}" Visibility="{Binding Installing, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Отмена" Tag="{StaticResource IconX}" Style="{StaticResource SecondaryIcon}" Command="{Binding CancelCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Устанавливаю…" Style="{StaticResource CardTitle}" />
                                <ProgressBar Style="{StaticResource Progress}" Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,10,0,8" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Check result -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconFolder}" Margin="0,0,14,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RootText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,4">
                                <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}">
                                    <TextBlock Text="{Binding InstallSummary}" Style="{StaticResource TagText}" Foreground="{StaticResource Ok}" />
                                </Border>
                                <Border Style="{StaticResource Tag}" Background="{StaticResource CritSoft}">
                                    <TextBlock Text="{Binding BlockedCount, StringFormat=Заблокировано: {0}}" Style="{StaticResource TagText}" Foreground="{StaticResource Crit}" />
                                </Border>
                                <Border Style="{StaticResource Tag}" Background="{StaticResource NeutralSoft}">
                                    <TextBlock Text="{Binding SkippedCount, StringFormat=Пропущено: {0}}" Style="{StaticResource TagText}" />
                                </Border>
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconAlert}" Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Inset}" Margin="0,4,0,4" Visibility="{Binding NeedsRootConfirmation, Converter={StaticResource BoolToVis}}">
                                <CheckBox IsChecked="{Binding AcceptUnknownRoot}"
                                          Content="Я проверил пак: скопировать файлы в папку GTA V так, как они лежат в паке" />
                            </Border>

                            <Expander Header="{Binding InstallHeader}" Margin="0,8,0,0">
                                <Border Style="{StaticResource Inset}" Margin="18,8,0,0">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding InstallFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,0,6,0" />
                                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                            <Expander Header="{Binding BlockedHeader}" Margin="0,6,0,0" Visibility="{Binding BlockedCount, Converter={StaticResource CountToVisible}}">
                                <Border Style="{StaticResource Inset}" Margin="18,8,0,0">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding BlockedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,4">
                                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{StaticResource Crit}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                            <Expander Header="{Binding SkippedHeader}" Margin="0,6,0,0" Visibility="{Binding SkippedCount, Converter={StaticResource CountToVisible}}">
                                <Border Style="{StaticResource Inset}" Margin="18,8,0,0">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SkippedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,0,6,0" />
                                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>

                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="Установить" Tag="{StaticResource IconCheck}" Style="{StaticResource PrimaryIcon}" Command="{Binding InstallCommand}" Padding="24,12" />
                                <Button DockPanel.Dock="Right" Content="Сбросить" Tag="{StaticResource IconX}" Style="{StaticResource GhostIcon}" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,16,0"
                                           Text="Заменяемые файлы игры переносятся в папку .framelab внутри GTA V (тот же диск, лишнего места не нужно) и вернутся при удалении пака." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Installed packs -->
                    <TextBlock Text="Установленные паки" Style="{StaticResource Section}" Margin="0,12,0,10" />
                    <Border Style="{StaticResource Inset}" Visibility="{Binding HasInstalled, Converter={StaticResource NotVis}}">
                        <TextBlock Text="Пока ничего не установлено через FrameLab." Style="{StaticResource MutedText}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Installed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18,14" CornerRadius="14" BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Panel}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
