        <!-- ===================== ABOUT ===================== -->
        <TabItem Header="О программе" Tag="{StaticResource IconInfo}" DataContext="{Binding About}">
            <Grid Margin="32,26,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="О программе" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource PageSub}" />
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource StripeCard}" BorderBrush="{StaticResource Ok}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Принципы" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Margin="0,6,0,0" Text="• Оффлайн: без аккаунтов, телеметрии и автообновлений.&#x0a;• Честно: у каждого твика метка эффекта и объяснение; спорные выключены.&#x0a;• Безопасно: не трогает процесс и память игры (VAC-безопасно).&#x0a;• Обратимо: копии «до», точка восстановления, «Отменить» рядом с каждым изменением." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StripeCard}" BorderBrush="{StaticResource Crit}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Что программа намеренно НЕ делает" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Text="Не отключает Defender, обновления и UAC; не «чистит реестр» и не «освобождает RAM»; не убивает процессы; не правит профили драйвера; не меняет TCP/Nagle/MTU; не разгоняет; не скачивает драйверы сама." />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DockPanel Margin="0,6,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Открыть папку логов" Style="{StaticResource Ghost}" Command="{Binding OpenLogsCommand}" />
                            <Button Content="Обновить лог" Style="{StaticResource Ghost}" Command="{Binding RefreshLogCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="Данные (логи, бэкапы, история): " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource Panel}" Padding="4">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
