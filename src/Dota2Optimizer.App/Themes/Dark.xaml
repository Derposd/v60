<ResourceDictionary xmlns:v="clr-namespace:Dota2Optimizer.App.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette: design B «Спецификация» (paper, ink, one accent). Names kept from the 1.4 dark theme. ============ -->
    <Color x:Key="BgColor">#F3F0E8</Color>
    <Color x:Key="SidebarColor">#F3F0E8</Color>
    <Color x:Key="PanelColor">#F3F0E8</Color>
    <Color x:Key="PanelAltColor">#ECE8DD</Color>
    <Color x:Key="HoverColor">#E6E1D4</Color>
    <Color x:Key="BorderColor">#CFC9B8</Color>
    <Color x:Key="BorderStrongColor">#141414</Color>
    <Color x:Key="TextColor">#141414</Color>
    <Color x:Key="MutedColor">#4A463E</Color>
    <Color x:Key="SubtleColor">#6B665B</Color>
    <Color x:Key="AccentColor">#141414</Color>
    <Color x:Key="AccentHoverColor">#2A2A2A</Color>
    <Color x:Key="AccentPressedColor">#000000</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Sidebar" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#14141414" />
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#141414" />
    <SolidColorBrush x:Key="OnAccent" Color="#F3F0E8" />
    <SolidColorBrush x:Key="HeroBorder" Color="#141414" />
    <SolidColorBrush x:Key="Rail" Color="#F3F0E8" />
    <!-- Cards: flat paper with a thin rule; no gradients. -->
    <SolidColorBrush x:Key="CardBg" Color="#F3F0E8" />
    <SolidColorBrush x:Key="CardRim" Color="#CFC9B8" />
    <SolidColorBrush x:Key="CardRimHover" Color="#141414" />
    <SolidColorBrush x:Key="InsetBg" Color="#ECE8DD" />
    <SolidColorBrush x:Key="Glow" Color="Transparent" />
    <!-- Section tiles in the rail: flat, ink text. -->
    <SolidColorBrush x:Key="DotaTile" Color="#E2DCCD" />
    <SolidColorBrush x:Key="Cs2Tile" Color="#E2DCCD" />
    <SolidColorBrush x:Key="PcTile" Color="#E2DCCD" />
    <SolidColorBrush x:Key="GtaTile" Color="#E2DCCD" />

    <SolidColorBrush x:Key="Ok" Color="#2F6B3C" />
    <SolidColorBrush x:Key="OkSoft" Color="#1A2F6B3C" />
    <SolidColorBrush x:Key="OkSoftBorder" Color="#2F6B3C" />
    <SolidColorBrush x:Key="Warn" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarnSoft" Color="#1A8A5A00" />
    <SolidColorBrush x:Key="Crit" Color="#B3261E" />
    <SolidColorBrush x:Key="CritSoft" Color="#1AB3261E" />
    <SolidColorBrush x:Key="Info" Color="#24508F" />
    <SolidColorBrush x:Key="InfoSoft" Color="#1A24508F" />
    <SolidColorBrush x:Key="NeutralSoft" Color="#10141414" />

    <SolidColorBrush x:Key="AccentGradient" Color="#141414" />
    <SolidColorBrush x:Key="HeroGradient" Color="Transparent" />
    <!-- Bars and gauges are large graphics: the one accent. -->
    <SolidColorBrush x:Key="BarGradient" Color="#E8380D" />

    <FontFamily x:Key="UiFont">pack://application:,,,/FrameLab;component/Assets/Fonts/#Inter Tight</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/FrameLab;component/Assets/Fonts/#Inter Tight</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/FrameLab;component/Assets/Fonts/#IBM Plex Mono</FontFamily>

