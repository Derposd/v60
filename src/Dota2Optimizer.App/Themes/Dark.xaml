    <!-- ============ Base ============ -->
    <Style TargetType="Window" x:Key="DarkWindow">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style TargetType="TextBlock" x:Key="PageTitle">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="PageSub">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="820" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="TextBlock" x:Key="H1">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="H2">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,26,0,12" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="CardTitle">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="MutedText">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Overline">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="StatNumber">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ============ Surfaces ============ -->
    <!-- Every card fades and rises in when its page opens, staggered by its position (skipped with «Уменьшить анимации»). -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="v:Fx.Appear" Value="True" />
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Kept for compatibility: same look as Card. -->
    <Style TargetType="Border" x:Key="StripeCard" BasedOn="{StaticResource Card}" />

    <!-- Page-top card with a warm gradient. -->
    <Style TargetType="Border" x:Key="Hero" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource HeroGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeroBorder}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="28,26" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Small accent line above a page title: the game or section the page belongs to. -->
    <Style TargetType="TextBlock" x:Key="Kicker">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Section heading row above a group of cards. -->
    <Style TargetType="TextBlock" x:Key="Section">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="Inset">
        <Setter Property="Background" Value="{StaticResource InsetBg}" />
        <Setter Property="BorderBrush" Value="#CFC9B8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style TargetType="Border" x:Key="StatTile">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <Style TargetType="Border" x:Key="Divider">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Small rounded label. -->
    <Style TargetType="Border" x:Key="Tag">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Background" Value="{StaticResource NeutralSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TagText">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Rounded square with a stroked icon: set Background (soft colour) and Tag (geometry); Foreground colours the icon. -->
    <Style TargetType="ContentControl" x:Key="IconBadge">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderThickness="1" BorderBrush="#14141414">
                        <Viewbox Margin="8.5">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stroked icon that follows its Foreground: set Tag to a geometry. -->
    <Style TargetType="ContentControl" x:Key="Icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyboard focus: a rounded accent ring instead of the default dotted rectangle. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{DynamicResource AccentHover}" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Buttons ============ -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="#F3F0E8" />
        <Setter Property="BorderBrush" Value="#CFC9B8" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="press" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <!-- Plain strings inherit the control's Foreground instead of the global TextBlock colour. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E6E1D4" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#141414" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource Dur.Instant}" />
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource Dur.Instant}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Dur.Fast}" EasingFunction="{StaticResource Ease.Pop}" />
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Dur.Fast}" EasingFunction="{StaticResource Ease.Pop}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="b" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Soft glow in the section accent (removed in performance mode). -->
                    <Border x:Name="b" Background="{DynamicResource AccentGradient}" CornerRadius="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            Effect="{DynamicResource Glow.Button}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="press" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <!-- Plain strings inherit the control's Foreground instead of the global TextBlock colour. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource Dur.Instant}" />
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource Dur.Instant}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Dur.Fast}" EasingFunction="{StaticResource Ease.Pop}" />
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Dur.Fast}" EasingFunction="{StaticResource Ease.Pop}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Ghost" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="Undo" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource OkSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource OkSoftBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Ok}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Button content with a leading icon: put the geometry into the button's Tag and the text into Content. -->
    <DataTemplate x:Key="IconContent">
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="Button" x:Key="PrimaryIcon" BasedOn="{StaticResource Primary}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
    </Style>
    <Style TargetType="Button" x:Key="SecondaryIcon" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
    </Style>
    <Style TargetType="Button" x:Key="GhostIcon" BasedOn="{StaticResource Ghost}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
    </Style>
    <Style TargetType="Button" x:Key="UndoIcon" BasedOn="{StaticResource Undo}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
    </Style>

    <!-- Borderless button (wizard stepper, accordion header). -->
    <Style TargetType="Button" x:Key="Flat">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Background="Transparent" Padding="0,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="c" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Inputs ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="0" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0"
                                BorderBrush="#141414" Background="{StaticResource PanelAlt}">
                            <Path x:Name="check" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" Margin="-1.5" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox as an on/off switch for options. -->
    <Style TargetType="CheckBox" x:Key="Switch">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="track" Width="38" Height="22" CornerRadius="0" Background="#F3F0E8" BorderBrush="#141414" BorderThickness="1" VerticalAlignment="Top">
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#141414" HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="thumb" Property="Fill" Value="White" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,2,18,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Stroke="#141414" StrokeThickness="1.5" Fill="{StaticResource PanelAlt}" />
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton as a segment of a segmented control (put several into a Border with style SegmentHost). -->
    <Style TargetType="RadioButton" x:Key="Segment">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="seg" CornerRadius="0" Padding="16,7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <!-- Plain strings inherit the control's Foreground instead of the global TextBlock colour. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="seg" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="SegmentHost">
        <Setter Property="Background" Value="{StaticResource PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InsetBg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#141414" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search field: Tag is the placeholder. -->
    <Style TargetType="TextBox" x:Key="SearchBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="0,8,12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="12,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Subtle}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <Grid>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Subtle}" Margin="2,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#141414" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain read-only text area (log viewer). -->
    <Style TargetType="TextBox" x:Key="Code">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game chip in the sidebar switcher (RadioButton). Background = the game's tile gradient, Content = monogram, Tag = name. -->
    <Style TargetType="RadioButton" x:Key="GameChip">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="chip" CornerRadius="0" Padding="4,8,4,7" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center">
                            <Border x:Name="tile" Width="40" Height="40" CornerRadius="0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderStrong}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="mono" Text="{TemplateBinding Content}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Black"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" LineHeight="16" />
                            </Border>
                            <TextBlock x:Name="label" Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtle}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" LineHeight="14" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="#0A141414" />
                            <Setter TargetName="mono" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="#14141414" />
                            <!-- Chosen section: ink tile, paper letters (like a checked box on the main screen). -->
                            <Setter TargetName="tile" Property="Background" Value="{StaticResource Text}" />
                            <Setter TargetName="tile" Property="BorderThickness" Value="0" />
                            <Setter TargetName="mono" Property="Foreground" Value="{StaticResource Bg}" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Navigation ============ -->
    <!-- One sidebar: brand, game switcher, the pages of the selected game, the PC card. DataContext of the TabControl is MainViewModel.
         The content area keeps a 40 px strip on top for the window caption, so pages never scroll under the caption buttons. -->
    <Style TargetType="TabControl" x:Key="SideNav">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="272" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="0,0,2,0">
                            <DockPanel>
                                <!-- The brand is in the window title bar (design B); here only the section label and the version. -->
                                <DockPanel DockPanel.Dock="Top" Margin="20,22,18,14">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding About.ShortVersion}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Subtle}" LineHeight="14" TextWrapping="NoWrap" />
                                    <v:SpacedText Text="ВСЕ РАЗДЕЛЫ" FontFamily="{StaticResource MonoFont}" FontSize="11" Tracking="0.14" Foreground="{StaticResource Subtle}" HorizontalAlignment="Left" />
                                </DockPanel>
                                <!-- Game switcher -->
                                <Border DockPanel.Dock="Top" Margin="14,0,14,8" Padding="5" CornerRadius="0" Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardRim}" BorderThickness="1">
                                    <UniformGrid Columns="4">
                                        <RadioButton Style="{StaticResource GameChip}" Content="ПК" Tag="Windows" Background="{StaticResource PcTile}" Foreground="#141414"
                                                     IsChecked="{Binding IsPc}" GroupName="game" ToolTip="Windows и другие игры: твики системы, игровой режим, пресеты Fortnite, Valorant, Minecraft, Apex, бенчмарк" />
                                        <RadioButton Style="{StaticResource GameChip}" Content="D2" Tag="Dota 2" Background="{StaticResource DotaTile}"
                                                     IsChecked="{Binding IsDota}" GroupName="game" ToolTip="Dota 2" />
                                        <RadioButton Style="{StaticResource GameChip}" Content="CS2" Tag="CS2" Background="{StaticResource Cs2Tile}" Foreground="#141414"
                                                     IsChecked="{Binding IsCs2}" GroupName="game" ToolTip="Counter-Strike 2" />
                                        <RadioButton Style="{StaticResource GameChip}" Content="RP" Tag="GTA RP" Background="{StaticResource GtaTile}"
                                                     IsChecked="{Binding IsGta}" GroupName="game" ToolTip="GTA V: GTA5RP, Majestic RP и другие RP-проекты" />
                                    </UniformGrid>
                                </Border>
                                <!-- PC card -->
                                <Border DockPanel.Dock="Bottom" Margin="14,8,14,16" Padding="12,11" CornerRadius="0" Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardRim}" BorderThickness="1">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource IconBadge}" Tag="{StaticResource IconCpu}" Width="36" Height="36" Margin="0,0,10,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Current.Wizard.ProfileShort}" FontWeight="SemiBold" LineHeight="18" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Current.Wizard.GpuShort}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer Focusable="False">
                                    <StackPanel IsItemsHost="True" Margin="0,2,0,8" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Accent glow from the top-right corner, recoloured with the section. -->
                            <Border Grid.RowSpan="2" Background="{DynamicResource Glow}" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="12,1">
                        <Border x:Name="b" Padding="12,9" CornerRadius="0" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <!-- Selected marker on the left edge. -->
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="0" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0D141414" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource AccentHover}" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Non-clickable section title between groups of tabs. -->
    <Style TargetType="TabItem" x:Key="NavSection">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Margin="26,18,12,6">
                        <ContentPresenter ContentSource="Header" TextElement.FontSize="10.5" TextElement.FontWeight="Bold" TextElement.Foreground="{StaticResource Subtle}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game tile in the left rail (RadioButton). Background = the game's tile gradient, Content = monogram. -->
    <Style TargetType="RadioButton" x:Key="GameTile">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Width="72" Margin="0,0,0,10">
                        <Border x:Name="pill" Width="4" Height="8" CornerRadius="0" Background="{StaticResource Text}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0" Opacity="0" />
                        <StackPanel HorizontalAlignment="Center">
                            <Border x:Name="tile" Width="48" Height="48" CornerRadius="0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                                <TextBlock x:Name="mono" Text="{TemplateBinding Content}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Black"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" LineHeight="18" />
                            </Border>
                            <TextBlock x:Name="label" Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtle}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="NoWrap" LineHeight="14" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tile" Property="BorderBrush" Value="#141414" />
                            <Setter TargetName="mono" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="pill" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tile" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="tile" Property="BorderThickness" Value="0" />
                            <Setter TargetName="mono" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="pill" Property="Opacity" Value="1" />
                            <Setter TargetName="pill" Property="Height" Value="34" />
                            <Setter TargetName="pill" Property="Margin" Value="0,7,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin rounded progress bar in the section accent. -->
    <Style TargetType="ProgressBar" x:Key="Progress">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="0" Background="{StaticResource PanelAlt}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="0" Background="{DynamicResource AccentGradient}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice card (RadioButton): highlighted border and soft accent fill when checked. Content = any layout. -->
    <Style TargetType="RadioButton" x:Key="ChoiceCard">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="card" CornerRadius="0" Padding="18,16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardRim}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource CardRimHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons (custom title bar). -->
    <Style TargetType="Button" x:Key="CaptionButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1A141414" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="CloseCaptionButton" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <Path x:Name="p" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#B3261E" />
                            <Setter TargetName="p" Property="Stroke" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Accordion card (Expander) ============ -->
    <Style TargetType="Expander" x:Key="AccordionCard">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="card" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hdr" Background="Transparent" Padding="18,16" CornerRadius="0">
                                            <DockPanel>
                                                <Viewbox x:Name="chev" DockPanel.Dock="Right" Width="16" Height="16" VerticalAlignment="Center" Margin="14,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="rot" Angle="90" />
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IconChevron}" Stroke="{StaticResource Subtle}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hdr" Property="Background" Value="#0B141414" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chev" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                            </ToggleButton>
                            <Border x:Name="body" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,16,18,18">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline expander: chevron + text link. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Viewbox x:Name="chev" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconChevron}" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <ContentPresenter TextElement.Foreground="{DynamicResource Accent}" TextElement.FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chev" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </ToggleButton>
                        <ContentPresenter x:Name="body" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Misc ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="#CFC9B8" CornerRadius="0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#6B665B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="2,4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="4,2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
